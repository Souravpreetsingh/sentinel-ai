# SENTINEL AI backend - environment configuration
# Copy to `.env` and adjust. Every value here can be overridden per-deployment.

# --- Application -----------------------------------------------------------
APP_NAME=SENTINEL AI
SERVICE_NAME=sentinel-ai
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000

# Comma separated list of allowed browser origins (Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database --------------------------------------------------------------
# PostgreSQL (recommended). Example:
#   DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel
# Leave empty to use the SQLite development fallback (sentinel.db).
DATABASE_URL=
USE_SQLITE=false

# --- Storage ---------------------------------------------------------------
UPLOADS_DIR=uploads
VIDEOS_DIR=videos

# --- Upload validation -----------------------------------------------------
MAX_UPLOAD_SIZE_MB=200
ALLOWED_VIDEO_EXTENSIONS=mp4,mov,avi,mkv,webm,m4v,mpeg
ALLOWED_EVIDENCE_EXTENSIONS=mp4,mov,avi,mkv,webm,jpg,jpeg,png,webp,json,txt,wav,mp3,aac

# --- Videos ----------------------------------------------------------------
# Optional demo video directory. Put a locally supplied clip in videos/demo/
# to exercise the real YOLO pipeline. Never download footage automatically.
VIDEOS_DEMO_DIR=

# --- AI / detection --------------------------------------------------------
# auto | yolo | mock
DETECTOR_BACKEND=auto
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE=0.40
# Leave empty to auto-select the device (CUDA when available, otherwise CPU).
YOLO_DEVICE=

# --- Inference / frame pipeline --------------------------------------------
# Run detection on every Nth frame (1 = every frame).
AI_PROCESS_EVERY_N_FRAMES=2
# Debounce identical events per (camera, type). Prevents incident spam.
EVENT_COOLDOWN_SECONDS=30

# --- Rule-based analytics thresholds ---------------------------------------
CROWD_LOW_MAX=15
CROWD_MEDIUM_MAX=30
CROWD_HIGH_THRESHOLD=31
ABANDONED_OBJECT_SECONDS=30.0
ABANDONED_OBJECT_CLASSES=bag,backpack,suitcase,box
VEHICLE_STOPPED_SECONDS=20.0
FALL_VELOCITY_THRESHOLD=6.0
# Vehicle density ratio (0..1) above which traffic congestion is flagged.
TRAFFIC_CONGESTION_THRESHOLD=0.75

# --- Output / debugging ----------------------------------------------------
# Write an annotated MP4 of the processed video (optional, can be slow).
GENERATE_OUTPUT_VIDEO=false
# Save annotated frames for model debugging (uploads/debug/).
AI_DEBUG=false
DEBUG_FRAME_EVERY_N=60

# --- Workers ---------------------------------------------------------------
BACKGROUND_WORKER=true
WORKER_POLL_SECONDS=1.0

# --- WebSocket -------------------------------------------------------------
# Development live-simulator broadcasting demo realtime events.
WS_SIMULATION=true

# --- Secrets (override in production!) -------------------------------------
SECRET_KEY=development-only-key-change-me